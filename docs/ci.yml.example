name: CI
on:
  push:
    branches: [main]
  pull_request:
jobs:
  check:
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@v4
      - uses: actions/setup-node@v4
        with:
          node-version: 22
          cache: npm
      - run: npm ci
      - run: npx tsc --noEmit
      - name: Core unit tests (sonar DSP, PDR, fusion, tracker, occupancy…)
        run: node --experimental-strip-types --test src/lib/core/*.test.ts
      - run: npx vite build
        env:
          VITE_AUTH_ENABLED: "false"
